# Copy to .env (same folder) and fill in. .env is git-ignored — never commit it.

# SQL Server — meter readings ([dbo].[SolarMeterReadings])
LEAP_DB_SERVER=your-server
LEAP_DB_DATABASE=leap
LEAP_DB_USER=your-user
LEAP_DB_PASSWORD=your-password
LEAP_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Azure Blob — Solcast live + forecast CSVs
AZURE_STORAGE_ACCOUNT_URL=https://leapdata.blob.core.windows.net
AZURE_STORAGE_CONTAINER=solar-forecasts-solcast
AZURE_STORAGE_SAS_TOKEN=your-sas-token

# Optional overrides
# PVDASH_DATA_DIR=/srv/pvdash/data        # default: ./data
# PVDASH_HOST=0.0.0.0
# PVDASH_PORT=8000
# PVDASH_ANALYSIS_START=2022-01-01     # long-term trends ignore data before this date
# PVDASH_TARIFF_AUD_PER_KWH=0.25
# PVDASH_CLEANING_COST_AUD=300
# PVDASH_CO2_KG_PER_KWH=0.79
# PVDASH_CO2_KG_PER_TREE=21
